# Anthropic API key — lấy tại console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — dùng cho embedding, lấy tại platform.openai.com > API Keys
OPENAI_API_KEY=sk-your-key-here

# JWT secret — tối thiểu 32 ký tự ngẫu nhiên, tự sinh (xem ONBOARDING.md mục 3)
JWT_SECRET=your-random-secret-min-32-chars
